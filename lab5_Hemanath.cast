[1654.914715, "o", "\u001b[51;75H          \u001b[4;1H\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[1;1H\u001b[38;5;81mimport\u001b[m logging\r\n\u001b[38;5;81mimport\u001b[m requests\r\n\u001b[38;5;81mfrom\u001b[m requests.auth\r\n\u001b[38;5;81mimport\u001b[m HTTPBasicAuth\r\n\u001b[38;5;81mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[95m'192.168.1.101'\u001b[m\r\nUSER = \u001b[95m'student'\u001b[m\r\nPASS = \u001b[95m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[95m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mset_interfaces\u001b[m(append_url, interface_name):\r\n url = BASE_URL + append_url + interface_name\r\n auth = HTTPBasicAuth(USER, PASS)\r\n headers = {\r\n  \u001b[95m'Accept'\u001b[m: \u001b[95m'application/vnd.yang.data+json'\u001b[m,\r\n  \u001b[95m'Content-Type'\u001b[m: \u001b[95m'application/vnd.yang.data+json'\u001b[m\r\n }\r\n data = {\r\n  \u001b[95m\"ietf-interfaces:interface\"\u001b[m: {\r\n  \u001b[95m\"name\"\u001b[m: \u001b[95m\"GigabitEthernet3\"\u001b[m,\r\n  \u001b[95m\"description\"\u001b[m: \u001b[95m\"Changed through Restconf\"\u001b[m,\r\n  \u001b[95m\"type\"\u001b[m: \u001b[95m\"iana-if-type:ethernetCsmacd\"\u001b[m,\r\n  \u001b[95m\"enabled\"\u001b[m: \u001b[95m'true'"]
