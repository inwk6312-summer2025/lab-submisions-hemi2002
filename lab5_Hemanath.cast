[1654.875083, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth\r\n\u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[31m'192.168.1.101'\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mset_interfaces\u001b[m(append_url, interface_name):\r\n url = BASE_URL + append_url + interface_name\r\n auth = HTTPBasicAuth(USER, PASS)\r\n headers = {\r\n  \u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m,\r\n  \u001b[31m'Content-Type'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m\r\n }\r\n data = {\r\n  \u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\r\n  \u001b[31m\"name\"\u001b[m: \u001b[31m\"GigabitEthernet3\"\u001b[m,\r\n  \u001b[31m\"description\"\u001b[m: \u001b[31m\"Changed through Restconf\"\u001b[m,\r\n  \u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\r\n  \u001b[31m\"enabled\"\u001b[m: \u001b[31m'true'\u001b[m,\r\n  \u001b[31m\"ietf-ip:ipv4\"\u001b[m: {\r\n  \u001b[31m\"address\"\u001b[m: [\r\n   {\r\n   \u001b[31m\"ip"]
[1654.87557, "o", "\"\u001b[m: \u001b[31m\"10.0.10.3\"\u001b[m,\r\n   \u001b[31m\"netmask\"\u001b[m: \u001b[31m\"255.255.255.0\"\u001b[m\r\n   }\r\n  ]\r\n },\r\n \u001b[31m\"ietf-ip:ipv6\"\u001b[m: {}\r\n }\r\n }\r\n response = requests.put(url, auth=auth, headers=headers,\r\ndata=json.dumps(data))\r\n \u001b[38;5;130mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\r\n  logging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\r\n  \u001b[38;5;130mreturn\u001b[m \u001b[31m\"success!\"\u001b[m\r\n \u001b[38;5;130melse\u001b[m:\r\n  logging.error(f\u001b[31m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\r\n  \u001b[38;5;130mreturn\u001b[m response.text\r\n\u001b[36mprint\u001b[m (set_interfaces(\u001b[31m\"interfaces/interface/\"\u001b[m, \u001b[31m\"GigabitEthernet3\"\u001b[m))\r\n\r\n\u001b[94m~                                                                                                     \u001b[46;1H~                                                                                                     \u001b[47;1H~                                                                                                     "]
[1654.876059, "o", "\u001b[48;1H~                                                                                                     \u001b[49;1H~                                                                                                     \u001b[50;1H~                                                                                                     \u001b[m\u001b[51;85H4,1\u001b[11CAll\u001b[4;1H\u001b[?25h"]
