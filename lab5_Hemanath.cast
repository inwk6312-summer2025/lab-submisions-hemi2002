[2536.724377, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[31m'192.168.1.101'\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mset_interfaces\u001b[m(append_url, interface_name):\r\n    url = BASE_URL + append_url + interface_name\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[14;9H\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m,\u001b[15;9H\u001b[31m'Content-Type'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m\u001b[16;9H}\r\n    data = {\u001b[18;9H\u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\u001b[19;13H\u001b[31m\"name\"\u001b[m: \u001b[31m\"GigabitEthernet3\"\u001b[m,\u001b[20;13H\u001b[31m\"description\"\u001b[m: \u001b[31m\"Changed through Restconf\"\u001b[m,\u001b[21;13H\u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[22;13H\u001b[31m\"enabled\"\u001b[m: \u001b[31m'true'\u001b[m,\u001b[23;13H\u001b[31m\"ietf-ip:ipv4\"\u001b[m: "]
[2536.72485, "o", "{\u001b[24;17H\u001b[31m\"address\"\u001b[m: [\u001b[25;22H{\u001b[26;25H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"10.0.10.3\"\u001b[m,\u001b[27;25H\u001b[31m\"netmask\"\u001b[m: \u001b[31m\"255.255.255.0\"\u001b[m\u001b[28;22H}\u001b[29;14H]\u001b[30;9H},\u001b[31;9H\u001b[31m\"ietf-ip:ipv6\"\u001b[m: {}\u001b[32;14H}\u001b[33;9H}\r\n    response = requests.put(url, auth=auth, headers=headers,\r\ndata=json.dumps(data))\r\n    \u001b[38;5;130mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\u001b[37;9Hlogging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[38;9H\u001b[38;5;130mreturn\u001b[m \u001b[31m\"success!\"\u001b[m\r\n    \u001b[38;5;130melse\u001b[m:\u001b[40;9Hlogging.error(f\u001b[31m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[41;9H\u001b[38;5;130mreturn\u001b[m response.text\r\n\u001b[36mprint\u001b[m (set_interfaces(\u001b[31m\"interfaces/interface/\"\u001b[m, \u001b[31m\"GigabitEthernet3\"\u001b[m))\r\n\r\n\u001b[94m~                                                                                                     \u001b[45;1H~                                                                                                     "]
