[1091.354644, "o", "\u001b[m,\r\n  \u001b[95m\"ietf-ip:ipv4\"\u001b[m: {\r\n  \u001b[95m\"address\"\u001b[m: [\r\n  {\r\n  \u001b[95m\"ip\"\u001b[m: \u001b[95m\"10.0.10.3\"\u001b[m,\r\n  \u001b[95m\"netmask\"\u001b[m: \u001b[95m\"255.255.255.0\"\u001b[m\r\n  }\r\n  ]\r\n  },\r\n  \u001b[95m\"ietf-ip:ipv6\"\u001b[m: {}\r\n  }\r\n  }\r\n response = requests.put(url, auth=auth, headers=headers,\r\n data=json.dumps(data))\r\n  \u001b[93mif\u001b[m response.status_code == \u001b[95m204\u001b[m:\r\n   logging.info(f\u001b[95m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\r\n   \u001b[93mreturn\u001b[m \u001b[95m\"success!\"\u001b[m\r\n  \u001b[93melse\u001b[m:\r\n   logging.error(f\u001b[95m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\r\n   \u001b[93mreturn\u001b[m response.text\r\n\u001b[1m\u001b[96mprint\u001b[m (set_interfaces(\u001b[95m\"interfaces/interface/\"\u001b[m, \u001b[95m\"GigabitEthernet3\"\u001b[m))\r\n\r\n\u001b[94m~                                                                                                     \u001b[45;1H~                                                                                                     \u001b[46;1H~                                                                              "]
