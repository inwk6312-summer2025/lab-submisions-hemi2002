[2536.73318, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[1;1H\u001b[38;5;81mimport\u001b[m logging\r\n\u001b[38;5;81mimport\u001b[m requests\r\n\u001b[38;5;81mfrom\u001b[m requests.auth \u001b[38;5;81mimport\u001b[m HTTPBasicAuth\r\n\u001b[38;5;81mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[95m'192.168.1.101'\u001b[m\r\nUSER = \u001b[95m'student'\u001b[m\r\nPASS = \u001b[95m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[95m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mset_interfaces\u001b[m(append_url, interface_name):\r\n    url = BASE_URL + append_url + interface_name\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[14;9H\u001b[95m'Accept'\u001b[m: \u001b[95m'application/vnd.yang.data+json'\u001b[m,\u001b[15;9H\u001b[95m'Content-Type'\u001b[m: \u001b[95m'application/vnd.yang.data+json'\u001b[m\u001b[16;9H}\r\n    data = {\u001b[18;9H\u001b[95m\"ietf-interfaces:interface\"\u001b[m: {\u001b[19;13H\u001b[95m\"name\"\u001b[m: \u001b[95m\"GigabitEthernet3\"\u001b[m,\u001b[20;13H\u001b[95m\"description\"\u001b[m: \u001b[95m\"Changed through Restconf\"\u001b[m,\u001b[21;13H\u001b[95m\"type\"\u001b[m: \u001b[95m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[22;13H\u001b[95m\"en"]
[2536.733691, "o", "abled\"\u001b[m: \u001b[95m'true'\u001b[m,\u001b[23;13H\u001b[95m\"ietf-ip:ipv4\"\u001b[m: {\u001b[24;17H\u001b[95m\"address\"\u001b[m: [\u001b[25;22H{\u001b[26;25H\u001b[95m\"ip\"\u001b[m: \u001b[95m\"10.0.10.3\"\u001b[m,\u001b[27;25H\u001b[95m\"netmask\"\u001b[m: \u001b[95m\"255.255.255.0\"\u001b[m\u001b[28;22H}\u001b[29;14H]\u001b[30;9H},\u001b[31;9H\u001b[95m\"ietf-ip:ipv6\"\u001b[m: {}\u001b[32;14H}\u001b[33;9H}\r\n    response = requests.put(url, auth=auth, headers=headers,\r\ndata=json.dumps(data))\r\n    \u001b[93mif\u001b[m response.status_code == \u001b[95m204\u001b[m:\u001b[37;9Hlogging.info(f\u001b[95m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[38;9H\u001b[93mreturn\u001b[m \u001b[95m\"success!\"\u001b[m\r\n    \u001b[93melse\u001b[m:\u001b[40;9Hlogging.error(f\u001b[95m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[41;9H\u001b[93mreturn\u001b[m response.text\r\n\u001b[1m\u001b[96mprint\u001b[m (set_interfaces(\u001b[95m\"interfaces/interface/\"\u001b[m, \u001b[95m\"GigabitEthernet3\"\u001b[m))\r\n\r\n\u001b[94m~                                                                                                     \u001b[45;1H~                                                                                                     "]
